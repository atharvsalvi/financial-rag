NODE_ENV=development
PORT=3000
POSTGRES_USER=financialresearch
POSTGRES_PASSWORD=password
POSTGRES_DB=financialresearch
DATABASE_URL=postgresql://financialresearch:replace-with-local-password@localhost:5432/financialresearch?schema=public
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
